tab7:CreateToggle("Anti Kick", function(state)
    local connections2 = {}
    local function hookKick()
        local mt = getrawmetatable(game)
        local oldNamecall = mt.__namecall
        setreadonly(mt, false)
        mt.__namecall = newcclosure(function(self, ...)
            if getnamecallmethod() == "Kick" and self == player then
                warn("[AntiKick]: Kick blocked") return nil
            end
            return oldNamecall(self, ...)
        end)
        player.Kick = function() warn("[AntiKick]: Direct kick blocked") return nil end
        setreadonly(mt, true)
    end
    local function enable()
        hookKick()
    end
    local function disable()
        for _, con in ipairs(connections2) do
            if typeof(con) == "RBXScriptConnection" then pcall(function() con:Disconnect() end) end
        end
        table.clear(connections2)
    end
    if state then enable() else disable() end
end)

